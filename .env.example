# ───────── Copia este archivo a .env (en la raíz). En desarrollo todo es opcional. ─────────
# En producción define estas variables en el panel de tu hosting, NUNCA en el repositorio.

NODE_ENV=development            # en producción: production

# Base de datos PostgreSQL. Un esquema por servicio (auth, catalog, reviews) dentro de la misma base.
DATABASE_URL=postgres://enscafe:enscafe@localhost:5432/enscafe
# DATABASE_SSL=true             # actívalo con proveedores gestionados (Neon, Supabase, Railway…)
# Opcional: una base/servidor/rol distinto por servicio (aislamiento total)
# AUTH_DATABASE_URL=
# CATALOG_DATABASE_URL=
# REVIEWS_DATABASE_URL=
# AUTO_MIGRATE=false            # si prefieres ejecutar `pnpm db:migrate` tú mismo en cada despliegue

# Secretos (producción: mínimo 32 caracteres, distintos entre sí). Generar: openssl rand -base64 48
JWT_SECRET=
INTERNAL_KEY=

# CORS: dominios del frontend permitidos, separados por coma
# CORS_ORIGINS=https://enscafe.pages.dev,https://www.tudominio.com

# Detrás de Cloudflare / un proxy
# TRUST_PROXY=1
# TRUST_CLOUDFLARE=true         # usa CF-Connecting-IP como IP del cliente (solo si el origen solo recibe tráfico de Cloudflare)

# CAPTCHA (Cloudflare Turnstile). Sin TURNSTILE_SECRET en desarrollo el captcha se omite; en producción es obligatorio.
# Claves de prueba: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET=
# CAPTCHA_DISABLED=true         # solo si decides prescindir del captcha en producción
# (frontend, en frontend/.env o en Cloudflare Pages) VITE_TURNSTILE_SITE_KEY=

# Correo (verificación y recuperación). Sin SMTP_HOST en desarrollo los correos se imprimen en la consola de `auth`.
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false             # true si usas el puerto 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="EnsCafe <no-reply@tudominio.com>"
# APP_URL=https://www.tudominio.com   # URL pública del frontend (enlaces de los correos)

# Sesión en cookies HttpOnly
# COOKIE_SAMESITE=lax           # lax (mismo sitio) | none (sitios distintos; exige HTTPS)
# COOKIE_DOMAIN=.tudominio.com
# ACCESS_TTL_SECONDS=900
# REFRESH_IDLE_DAYS=14
# REFRESH_ABSOLUTE_DAYS=30
# ROTATE_GRACE_SECONDS=10

# Datos de ejemplo (administrador demo y cafeterías de ejemplo). Por defecto: true en desarrollo, false en producción
# SEED_DEMO=false

# Puertos (el hosting suele asignar PORT al gateway)
# PORT=4000
